{
  "openapi": "3.1.0",
  "info": {
    "title": "MCP WhatsApp Gateway REST & MCP Server API",
    "version": "2.0.0",
    "description": "API REST unificada y Servidor MCP multicanal para conectar agentes de Inteligencia Artificial (Cursor, Claude Desktop, Claude Code, Windsurf) y aplicaciones a WhatsApp.\n\n### 🔌 Cómo conectar tu Agente de IA mediante el protocolo MCP\nEl servidor expone el endpoint oficial del protocolo Model Context Protocol (MCP) en `/mcp` mediante transporte **Streamable HTTP / SSE**.\n\n- **Endpoint MCP:** `http://localhost:3000/mcp` (o `http://<tu-host>:<puerto>/mcp`)\n- **Transporte:** Streamable HTTP / Server-Sent Events (SSE)\n- **Autenticación:** Si se configuró la variable de entorno `MCP_API_TOKEN`, envía la cabecera `Authorization: Bearer <MCP_API_TOKEN>`\n\n#### Configuración para Cursor (`.cursor/mcp.json`):\n```json\n{\n  \"mcpServers\": {\n    \"whatsapp\": {\n      \"url\": \"http://localhost:3000/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer tu-token-mcp-secreto\"\n      }\n    }\n  }\n}\n```\n\n#### Configuración para Claude Desktop (`claude_desktop_config.json`):\n```json\n{\n  \"mcpServers\": {\n    \"whatsapp\": {\n      \"command\": \"npx\",\n      \"args\": [\n        \"-y\",\n        \"@modelcontextprotocol/inspector\",\n        \"--sse\",\n        \"http://localhost:3000/mcp\"\n      ],\n      \"headers\": {\n        \"Authorization\": \"Bearer tu-token-mcp-secreto\"\n      }\n    }\n  }\n}\n```\n\n#### Configuración para Claude Code CLI:\n```bash\nclaude mcp add whatsapp http://localhost:3000/mcp --header \"Authorization: Bearer tu-token-mcp-secreto\"\n```"
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor actual"
    }
  ],
  "tags": [
    {
      "name": "Mensajería",
      "description": "Envío y consulta de mensajes de texto, multimedia, ubicación, contactos y reacciones"
    },
    {
      "name": "Chats y Verificación",
      "description": "Gestión de conversaciones y verificación de números en WhatsApp"
    },
    {
      "name": "Grupos",
      "description": "Creación y administración de grupos de WhatsApp"
    },
    {
      "name": "Sesión WhatsApp Web (Baileys)",
      "description": "Control de socket, generación de QR y estado de emparejamiento directo"
    },
    {
      "name": "Administración",
      "description": "Gestión de proveedores, canales / líneas y métricas del sistema"
    },
    {
      "name": "Disparadores (Webhooks)",
      "description": "Gestión de disparadores salientes con cola Outbox persistente y reintentos"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token Bearer configurado en MCP_API_TOKEN o JWT de administración"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API Key alternativa para peticiones REST"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        },
        "required": ["error"]
      },
      "SendResult": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "channel": { "type": "string" },
          "result": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "messageId": { "type": "string" },
              "timestamp": { "type": "integer" }
            }
          }
        }
      },
      "SendTextRequest": {
        "type": "object",
        "required": ["recipient", "text"],
        "properties": {
          "recipient": {
            "type": "string",
            "description": "Número telefónico del destinatario en formato E.164 (ej: 18095551234) o JID de grupo",
            "example": "18095551234"
          },
          "text": {
            "type": "string",
            "description": "Texto del mensaje a enviar",
            "example": "¡Hola! Este es un mensaje desde la API."
          },
          "channel": {
            "type": "string",
            "description": "Nombre de la línea/canal de origen (opcional, usa Default si se omite)",
            "example": "ventas"
          },
          "delay": {
            "type": "integer",
            "description": "Retardo de simulación de escritura en milisegundos (ej: 1200)",
            "example": 1000
          },
          "linkPreview": {
            "type": "boolean",
            "description": "Si es true, genera vista previa enriquecida para URLs en el texto",
            "example": true
          }
        }
      },
      "SendMediaRequest": {
        "type": "object",
        "required": ["recipient", "mediaType"],
        "properties": {
          "recipient": { "type": "string", "example": "18095551234" },
          "mediaType": {
            "type": "string",
            "enum": ["image", "video", "audio", "document", "sticker"],
            "example": "image"
          },
          "mediaUrl": { "type": "string", "example": "https://ejemplo.com/foto.jpg" },
          "mediaBase64": { "type": "string", "description": "Contenido del archivo en Base64" },
          "caption": { "type": "string", "example": "Comprobante de envío" },
          "fileName": { "type": "string", "example": "documento.pdf" },
          "mimetype": { "type": "string", "example": "image/jpeg" },
          "channel": { "type": "string", "example": "soporte" }
        }
      },
      "SendLocationRequest": {
        "type": "object",
        "required": ["recipient", "latitude", "longitude"],
        "properties": {
          "recipient": { "type": "string", "example": "18095551234" },
          "latitude": { "type": "number", "example": 18.4861 },
          "longitude": { "type": "number", "example": -69.9312 },
          "name": { "type": "string", "example": "Oficina Central" },
          "address": { "type": "string", "example": "Av. Principal 123" },
          "channel": { "type": "string" }
        }
      },
      "SendContactRequest": {
        "type": "object",
        "required": ["recipient", "contactName", "contactPhone"],
        "properties": {
          "recipient": { "type": "string", "example": "18095551234" },
          "contactName": { "type": "string", "example": "Juan Pérez" },
          "contactPhone": { "type": "string", "example": "+18095559999" },
          "channel": { "type": "string" }
        }
      },
      "SendReactionRequest": {
        "type": "object",
        "required": ["recipient", "messageId", "reaction"],
        "properties": {
          "recipient": { "type": "string", "example": "18095551234" },
          "messageId": { "type": "string", "example": "3EB0ABC123456789" },
          "reaction": { "type": "string", "example": "👍" },
          "channel": { "type": "string" }
        }
      }
    }
  },
  "security": [
    { "BearerAuth": [] },
    { "ApiKeyAuth": [] }
  ],
  "paths": {
    "/api/messages/text": {
      "post": {
        "tags": ["Mensajería"],
        "summary": "Enviar Mensaje de Texto",
        "description": "Envía un mensaje de texto plano con soporte para menciones, enlaces y simulación de escritura.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendTextRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mensaje enviado exitosamente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SendResult" }
              }
            }
          },
          "400": { "description": "Datos de entrada inválidos" },
          "401": { "description": "No autorizado" }
        }
      }
    },
    "/api/messages/media": {
      "post": {
        "tags": ["Mensajería"],
        "summary": "Enviar Archivo Multimedia",
        "description": "Envía imágenes, videos, audios, documentos o stickers vía URL o base64.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendMediaRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Multimedia enviado con éxito",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SendResult" }
              }
            }
          }
        }
      }
    },
    "/api/messages/location": {
      "post": {
        "tags": ["Mensajería"],
        "summary": "Enviar Ubicación GPS",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendLocationRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Ubicación enviada exitosamente" }
        }
      }
    },
    "/api/messages/contact": {
      "post": {
        "tags": ["Mensajería"],
        "summary": "Enviar Tarjeta de Contacto",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendContactRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Contacto enviado exitosamente" }
        }
      }
    },
    "/api/messages/reaction": {
      "post": {
        "tags": ["Mensajería"],
        "summary": "Reaccionar a un Mensaje con Emoji",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendReactionRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Reacción aplicada exitosamente" }
        }
      }
    },
    "/api/messages": {
      "get": {
        "tags": ["Mensajería"],
        "summary": "Consultar Historial de Mensajes",
        "parameters": [
          { "name": "chatId", "in": "query", "required": true, "schema": { "type": "string" }, "example": "18095551234@s.whatsapp.net" },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "channel", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Lista de mensajes del chat" }
        }
      }
    },
    "/api/chats": {
      "get": {
        "tags": ["Chats y Verificación"],
        "summary": "Listar Conversaciones Activas",
        "parameters": [
          { "name": "channel", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Lista de chats recientes" }
        }
      }
    },
    "/api/chats/check-number/{phone}": {
      "get": {
        "tags": ["Chats y Verificación"],
        "summary": "Verificar si un Número está en WhatsApp",
        "parameters": [
          { "name": "phone", "in": "path", "required": true, "schema": { "type": "string" }, "example": "18095551234" },
          { "name": "channel", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Resultado de verificación",
            "content": {
              "application/json": {
                "example": {
                  "channel": "demo1",
                  "result": { "exists": true, "jid": "18095551234@s.whatsapp.net", "number": "18095551234" }
                }
              }
            }
          }
        }
      }
    },
    "/api/groups": {
      "post": {
        "tags": ["Grupos"],
        "summary": "Crear un Nuevo Grupo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["subject", "participants"],
                "properties": {
                  "subject": { "type": "string", "example": "Grupo Soporte" },
                  "participants": { "type": "array", "items": { "type": "string" }, "example": ["18095551234"] },
                  "channel": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Grupo creado exitosamente" }
        }
      }
    },
    "/api/groups/{jid}": {
      "get": {
        "tags": ["Grupos"],
        "summary": "Obtener Información y Miembros de un Grupo",
        "parameters": [
          { "name": "jid", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "channel", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Detalles del grupo" }
        }
      },
      "delete": {
        "tags": ["Grupos"],
        "summary": "Abandonar un Grupo",
        "parameters": [
          { "name": "jid", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "channel", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Grupo abandonado con éxito" }
        }
      }
    },
    "/api/groups/{jid}/participants": {
      "post": {
        "tags": ["Grupos"],
        "summary": "Administrar Participantes del Grupo",
        "parameters": [
          { "name": "jid", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action", "participants"],
                "properties": {
                  "action": { "type": "string", "enum": ["add", "remove", "promote", "demote"] },
                  "participants": { "type": "array", "items": { "type": "string" } },
                  "channel": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Participantes actualizados" }
        }
      }
    },
    "/api/admin/channels/{id}/session/start": {
      "post": {
        "tags": ["Sesión WhatsApp Web (Baileys)"],
        "summary": "Iniciar o Reconectar Sesión de Canal",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "forceNew": { "type": "boolean", "description": "Forzar reinicio limpio y nuevo código QR" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Estado de inicio de sesión retornado" }
        }
      }
    },
    "/api/admin/channels/{id}/session/qr": {
      "get": {
        "tags": ["Sesión WhatsApp Web (Baileys)"],
        "summary": "Obtener Código QR y Estado en Tiempo Real",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Estado de la sesión y Data URL PNG del QR",
            "content": {
              "application/json": {
                "example": {
                  "channelId": "ch-123",
                  "status": "qr_ready",
                  "qrDataUrl": "data:image/png;base64,...",
                  "userPhone": null,
                  "isConnected": false
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/channels/{id}/session/logout": {
      "post": {
        "tags": ["Sesión WhatsApp Web (Baileys)"],
        "summary": "Cerrar Sesión y Desvincular Canal",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Sesión desconectada y credenciales eliminadas" }
        }
      }
    },
    "/api/admin/dashboard": {
      "get": {
        "tags": ["Administración"],
        "summary": "Métricas y Estado del Sistema",
        "responses": {
          "200": { "description": "Estadísticas del gateway y canal predeterminado" }
        }
      }
    },
    "/api/admin/triggers": {
      "get": {
        "tags": ["Disparadores (Webhooks)"],
        "summary": "Listar todos los disparadores configurados",
        "responses": {
          "200": { "description": "Lista de disparadores con estadísticas de entrega" }
        }
      },
      "post": {
        "tags": ["Disparadores (Webhooks)"],
        "summary": "Crear un nuevo disparador (Webhook saliente)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "targetUrl"],
                "properties": {
                  "name": { "type": "string", "example": "Webhook CRM" },
                  "channelId": { "type": "string", "nullable": true, "description": "ID del canal o null para todos" },
                  "targetUrl": { "type": "string", "example": "https://api.crm.com/v1/leads" },
                  "targetMethod": { "type": "string", "enum": ["POST", "PUT", "GET"], "default": "POST" },
                  "targetHeaders": { "type": "object", "example": { "Content-Type": "application/json", "Authorization": "Bearer secret" } },
                  "payloadMode": { "type": "string", "enum": ["standard", "custom"], "default": "standard" },
                  "payloadTemplate": { "type": "object", "example": { "phone": "{{sender.phoneNumber}}", "notes": "{{message.text}}" } },
                  "filterMessageType": { "type": "string", "default": "all" },
                  "filterIgnoreGroups": { "type": "boolean", "default": true },
                  "filterKeyword": { "type": "string", "nullable": true },
                  "timeoutMs": { "type": "integer", "default": 5000 },
                  "maxRetries": { "type": "integer", "default": 3 },
                  "retryDelayMs": { "type": "integer", "default": 10000 },
                  "secretToken": { "type": "string", "nullable": true, "description": "Secreto para firma HMAC-SHA256" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Disparador creado con éxito" }
        }
      }
    },
    "/api/admin/triggers/{id}": {
      "get": {
        "tags": ["Disparadores (Webhooks)"],
        "summary": "Obtener disparador por ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Detalle del disparador" } }
      },
      "put": {
        "tags": ["Disparadores (Webhooks)"],
        "summary": "Actualizar disparador existente",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Disparador actualizado" } }
      },
      "delete": {
        "tags": ["Disparadores (Webhooks)"],
        "summary": "Eliminar disparador",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Disparador eliminado" } }
      }
    },
    "/api/admin/triggers/{id}/test": {
      "post": {
        "tags": ["Disparadores (Webhooks)"],
        "summary": "Probar disparador en tiempo real con datos simulados",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Resultado de la prueba HTTP con status code y latencia" } }
      }
    },
    "/api/admin/triggers/{id}/deliveries": {
      "get": {
        "tags": ["Disparadores (Webhooks)"],
        "summary": "Consultar historial de entregas de un disparador",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Historial de entregas y estado" } }
      }
    },
    "/api/admin/triggers/{id}/retry-failed": {
      "post": {
        "tags": ["Disparadores (Webhooks)"],
        "summary": "Reintentar masivamente todas las entregas fallidas",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Cantidad de entregas reenviadas a la cola de procesamiento" } }
      }
    }
  }
}
